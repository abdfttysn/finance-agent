# =====================================================
# Worker Multi-Agent — Environment Configuration
# =====================================================
# Copy file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke repository!

# -------------------------------------------------------
# Google Gemini API
# Dapatkan dari: https://aistudio.google.com/apikey
# -------------------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key
AI_MODEL_NAME=gemini-2.0-flash

# -------------------------------------------------------
# ElingCash API
# BASE_URL: URL aplikasi ElingCash yang berjalan (Laragon lokal)
# TOKEN:    Sanctum Personal Access Token
#           Cara mendapatkan:
#           1. Login ke ElingCash → Profile → API Tokens → Create Token
#           2. Atau via Artisan:
#              php artisan tinker
#              >>> $user = App\Models\User::first();
#              >>> echo $user->createToken('worker-agent')->plainTextToken;
# -------------------------------------------------------
ELINGCASH_BASE_URL=http://localhost
ELINGCASH_TOKEN=your_sanctum_personal_access_token

# -------------------------------------------------------
# Worker Server Configuration
# -------------------------------------------------------
WORKER_HOST=0.0.0.0
WORKER_PORT=8000
