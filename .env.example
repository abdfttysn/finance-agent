# =====================================================
# AWS EC2 / Docker Compose Environment Configuration
# =====================================================
# Copy file ini menjadi .env di root project sebelum menjalankan `docker compose up`

# 1. Google Gemini API Key
GOOGLE_API_KEY=your_google_gemini_api_key
AI_MODEL_NAME=gemini-2.0-flash

# 2. ElingCash API Configuration
# Alamat URL ElingCash (misal: http://172.17.0.1 atau domain/IP publik ElingCash)
ELINGCASH_BASE_URL=http://your-elingcash-domain-or-ip
ELINGCASH_TOKEN=your_sanctum_personal_access_token
